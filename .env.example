# TrainingPlan Environment Configuration

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME=TrainingPlan
APP_VERSION=0.1.0
ENVIRONMENT=development  # development, production
DEBUG=true

# ============================================================================
# Database Configuration
# ============================================================================
# NAS Postgres is the only app database, including Mac development.
# Containers on the NAS use hostname "postgres". The Mac API uses the NAS IP.
DB_HOST=192.168.178.42
DB_PORT=5432
DB_NAME=trainingplan
DB_USER=trainingplan_user
# Must match the password Postgres was first initialized with (docker volume).
DB_PASSWORD=change_this_password
# Mac host (uvicorn). On the NAS, compose rewrites this to @postgres.
DATABASE_URL=postgresql+asyncpg://trainingplan_user:change_this_password@192.168.178.42:5432/trainingplan

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ============================================================================
# Backend API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional regex for NAS/private network frontend origins
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3})(:\d+)?$

# ============================================================================
# Authentication & Security
# ============================================================================
# Leave empty to auto-detect host at runtime (recommended for NAS/domain access)
# VITE_API_URL=
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# ============================================================================
# Frontend Configuration
# ============================================================================
# Leave empty to auto-detect host at runtime (recommended for NAS/domain access)
# VITE_API_URL=
VITE_APP_NAME=TrainingPlan
VITE_ENABLE_PWA=true

# ============================================================================
# External Integrations - Garmin Connect
# ============================================================================
GARMIN_CLIENT_ID=your_garmin_client_id
GARMIN_CLIENT_SECRET=your_garmin_client_secret
GARMIN_REDIRECT_URI=http://localhost:3000/integrations/garmin/callback
GARMIN_API_BASE_URL=https://apis.garmin.com

# ============================================================================
# External Integrations - TrainingPeaks
# ============================================================================
TRAININGPEAKS_API_KEY=your_trainingpeaks_api_key
TRAININGPEAKS_CLIENT_ID=your_trainingpeaks_client_id
TRAININGPEAKS_CLIENT_SECRET=your_trainingpeaks_client_secret
TRAININGPEAKS_API_BASE_URL=https://api.trainingpeaks.com/v2

# ============================================================================
# External Integrations - Instagram (Facebook Login)
# ============================================================================
# Long-lived user token from the Graph API Explorer. Never commit the real value.
IG_ACCESS_TOKEN=your_long_lived_user_token
# Instagram professional account id (instagram_business_account.id)
IG_USER_ID=your_ig_user_id
# Instagram Web Session Cookie (for comment likers & automation scripts)
IG_SESSIONID=your_instagram_sessionid_cookie

# ============================================================================
# External Integrations - Strava
# ============================================================================
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=http://localhost:3000/integrations/strava/callback
STRAVA_API_BASE_URL=https://www.strava.com/api/v3

# ============================================================================
# Celery Configuration
# ============================================================================
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/2
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2
CELERY_TIMEZONE=Europe/Berlin

# ============================================================================
# Email Configuration (Optional - for notifications)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@trainingplan.local

# ============================================================================
# File Upload Configuration
# ============================================================================
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=50  # MB
ALLOWED_EXTENSIONS=tcx,fit,gpx

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json, text

# ============================================================================
# Traefik (Production)
# ============================================================================
TRAEFIK_DOMAIN=trainingplan.local
ACME_EMAIL=your_email@example.com

# ============================================================================
# Backup Configuration
# ============================================================================
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
