# Development Environment Variables
# Copy this file to .env.local and fill in your credentials
#
# NEVER use auto-login on NAS. Deploy strips frontend/.env.local and forces
# VITE_DEV_AUTO_LOGIN=false in docker-compose.qnap.yml.

# API URL (optional)
# Leave empty to auto-detect based on browser hostname (recommended for NAS)
# VITE_API_URL=

# Auto-login is DISABLED in code for deploy stability.
# Do not rely on these — they are ignored by authStore.
# VITE_DEV_AUTO_LOGIN=false
# VITE_DEV_EMAIL=
# VITE_DEV_PASSWORD=
